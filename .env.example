# WeatherGPT — Environment Template
# Copy to .env and fill values. Never commit .env (gitignored).
# See research.md #10, #11, #12 for pricing + whitelisting details
# See plan.md Phase 0.1 for account creation steps

# --- Agora Conversational AI Engine (https://console.agora.io) ---
# Required: Create project at https://sso.agora.io/en/signup -> Console -> Project Management
# Verify Conversational AI Engine is Enabled (RTC Services page)
# Starter expects AGORA_APP_ID / AGORA_APP_CERTIFICATE in server/.env
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Aliases for plan.md compatibility (same values)
APP_ID=${AGORA_APP_ID}
APP_CERTIFICATE=${AGORA_APP_CERTIFICATE}
# REST auth for POST /join — from Console -> RESTful API -> Customer ID/Secret
CUSTOMER_ID=
CUSTOMER_SECRET=
# Optional: restrict server region (US/CN/EU) — default US
AGORA_REGION=US

# --- Sarvam AI (Indic STT/TTS) — https://dashboard.sarvam.ai ---
# Free ₹100 credit, no card. Used only when language != en-IN (BYOK)
SARVAM_API_KEY=

# --- OpenAI (optional BYOK fallback, prefer managed) ---
# If using credential_mode: managed, leave blank — Agora bills via $0.10/min bundle
OPENAI_API_KEY=

# --- IMD — India Meteorological Department ---
# IP whitelisting required at https://api.imd.gov.in/public/index.php
# Can be empty during dev — backend falls back to USE_MOCK_IMD=true + sample JSON
IMD_API_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
# Public IP used for whitelisting (check via https://ifconfig.me)
PUBLIC_IP=

# --- Backend / Frontend URLs ---
BACKEND_URL=http://localhost:8000
# Phase 3.3: Agora llm.mcp_servers URL — must be public HTTPS in prod
# (plan.md 6.1). Defaults to ${BACKEND_URL}/mcp when unset.
MCP_SERVER_URL=
FRONTEND_URL=http://localhost:3000
PORT=8000

# --- Feature Flags (Free-tier guards per AGENTS.md #1) ---
USE_MOCK_IMD=true
IDLE_TIMEOUT=120
CACHE_TTL_SECONDS=300
CREDENTIAL_MODE=managed

# --- Optional Selective Attention Locking (Phase 5.2) ---
# Built-in Agora noise suppression remains on without these settings.
# SAL requires a public HTTPS voiceprint URL and is disabled by default.
SAL_ENABLED=false
SAL_MODE=locking
SAL_SAMPLE_URL=

# --- Telephony PSTN Beta (Phase 6.3) ---
# Request via Agora Console > Talk to Us (mention SIH26068). Until granted,
# /dial answers 501 and the phone-bridge fallback covers demos.
TELEPHONY_ENABLED=false
TELEPHONY_FROM_NUMBER=
