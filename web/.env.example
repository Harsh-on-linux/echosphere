# VaayuMitra frontend env (plan.md Step 6.1)
# Copy to .env.local for local dev. On Vercel (Hobby): Project -> Settings ->
# Environment Variables -> add AGENT_BACKEND_URL pointing at the deployed backend.
# Next.js /api/* rewrites (next.config.ts) proxy to this URL.

# Local dev (matches `bun run dev:frontend`)
AGENT_BACKEND_URL=http://localhost:8000

# Production example (Render free web service):
# AGENT_BACKEND_URL=https://vaayumitra-backend.onrender.com
