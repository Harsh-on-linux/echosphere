AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
PORT=8000
# WeatherGPT additions (optional — copied from root .env.example)
# SARVAM_API_KEY=
# CUSTOMER_ID=
# CUSTOMER_SECRET=
# IMD_API_URL=https://api.imd.gov.in/api/v1
# USE_MOCK_IMD=true
# IDLE_TIMEOUT=120
# CACHE_TTL_SECONDS=300
# Phase 3.3: explicit MCP URL for llm.mcp_servers (defaults to ${BACKEND_URL}/mcp)
# Agora cloud calls this directly, so it must be public HTTPS in prod.
# Local dev: cloudflared tunnel --url http://localhost:8000, then paste URL here.
# MCP_SERVER_URL=https://<tunnel>.trycloudflare.com/mcp
# MCP_ENDPOINT= (alias of MCP_SERVER_URL, recipe-agent-mcp name)
# BACKEND_URL=http://localhost:8000
# Phase 6.1 deploy: public URLs. BACKEND_URL must be the https Render/Railway
# URL in prod (Agora requires https for MCP); FRONTEND_URL is the Vercel URL
# (comma-separated ok) used for CORS. See render.yaml + README Deploy section.
# FRONTEND_URL=http://localhost:3000
# Phase 6.3 telephony (PSTN Beta): request via Console > Talk to Us (SIH26068),
# then set TELEPHONY_ENABLED=true + your Agora number. Until granted, /dial
# answers 501 and the phone-bridge fallback covers demos.
# TELEPHONY_ENABLED=false
# TELEPHONY_FROM_NUMBER=+910000000000
# Phase 5.2: SAL is disabled by default. Requires a public HTTPS voiceprint.
# SAL_ENABLED=false
# SAL_MODE=locking
# SAL_SAMPLE_URL=https://your-host.example.com/voiceprints/fisherman.wav
